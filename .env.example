# ---------------------------------------------------------------
# ShortForge yapilandirmasi. BU DOSYAYI .env OLARAK KOPYALA.
# Gercek anahtar ASLA git'e girmez. GitHub Actions'ta Secrets kullan.
# Kart bilgisi / ucretli API YOK - sadece ucretsiz katmanlar.
# ---------------------------------------------------------------

# --- Calisma modu ---
ENV=dev
LOG_LEVEL=INFO
# true iken: hicbir dis servise yazma/yukleme yapilmaz (kuru calisma)
DRY_RUN=true
DAILY_VIDEO_LIMIT=1

# --- YouTube Data API v3 (P4'te doldurulacak) ---
# 10.000 birim/gun; videos.insert 1600 birim => ~6 yukleme/gun (panelden dogrula)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_DAILY_UPLOAD_CAP=6

# --- Senaryo (LLM) ---
# Gemini API free tier (kart gerekmez)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Gorsel ---
# Pexels: 200 istek/saat, lisansli stok (ucretsiz API anahtari)
PEXELS_API_KEY=
# Pollinations: anonim calisir; kayit -> filigran kalkar + limit artar
POLLINATIONS_TOKEN=

# --- Muzik (Openverse: CC lisansli, anahtar opsiyonel) ---
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# --- Seslendirme ---
TTS_VOICE_TR=tr-TR-AhmetNeural

# --- Saglayici override (bos = otomatik secim) ---
# ornek: IMAGE_PROVIDER=pexels
IMAGE_PROVIDER=
TTS_PROVIDER=
LLM_PROVIDER=
MUSIC_PROVIDER=

# --- Yollar ---
STATE_DIR=state
OUT_DIR=out
ASSETS_DIR=assets
